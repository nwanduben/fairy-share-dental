# ---- Open Dental ----
# OD_MODE: "mock" (in-memory, offline) or "live" (Open Dental Remote API)
OD_MODE=mock
OD_BASE_URL=https://api.opendental.com/api/v1
# Public developer TEST keys are published at https://www.opendental.com/site/apisetup.html
# Never commit real practice keys.
OD_DEVELOPER_KEY=
OD_CUSTOMER_KEY=
# Remote API throttles 1 request/second for write-enabled keys (5s for ReadAll-only)
OD_MIN_INTERVAL_SECONDS=1.1
OD_TIMEOUT_SECONDS=30

# ---- Tool security ----
# Shared secret ElevenLabs sends in the X-Tool-Secret header (store it as a secret in ElevenLabs)
TOOL_SECRET=change-me-long-random-string
# Signs the opaque slot_id / patient_ref / appointment_ref tokens handed to the agent
REF_SIGNING_KEY=change-me-another-long-random-string

# ---- Confirmations (n8n) ----
# Production webhook URL of the "Fairy Share Dental - Appointment Confirmation" n8n workflow.
# Leave empty to disable confirmations.
N8N_CONFIRMATION_WEBHOOK_URL=
# Must match the Header Auth credential (X-FSD-Secret) on the n8n Webhook node
N8N_WEBHOOK_SECRET=
# Header name set in the n8n Header Auth credential (its "Name" field)
N8N_WEBHOOK_HEADER=X-FSD-Secret
# Demo: Telegram bots cannot message a phone number, so "telegram" confirmations go to this chat
# (e.g. your own chat with the bot, standing in for the patient's phone).
TELEGRAM_CHAT_ID=
# Demo only: deliver "text me" confirmations to TELEGRAM_CHAT_ID instead of real SMS (no Twilio needed).
DEMO_SMS_VIA_TELEGRAM=false
# WhatsApp: fallback number (E.164, e.g. +2348012345678) used when the caller gives none.
# Delivery itself is configured in the n8n WhatsApp node (Meta Cloud API).
WHATSAPP_NUMBER=

# Password for the read-only staff schedule viewer at /schedule (empty = page disabled)
ADMIN_PASSWORD=

# ---- App ----
CONFIG_DIR=config
LOG_LEVEL=INFO

# ---- ElevenLabs (used only by elevenlabs/provision_agent.py) ----
ELEVENLABS_API_KEY=
# Public HTTPS URL of this backend (cloudflared/ngrok tunnel or a host)
PUBLIC_BACKEND_URL=
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM=claude-haiku-4-5
ELEVENLABS_TTS_MODEL=eleven_flash_v2
